/* ===== Minimal qor ===== */
.snow { pointer-events: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; overflow: hidden; z-index: 5000; }
.snowflake { position: absolute; top: -10px; color: #fff; opacity: 0.7; font-size: 8px; animation: fall linear infinite; }
@keyframes fall { to { transform: translateY(105vh); } }
